<Application x:Class="SaleApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SaleApp.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Colors.xaml"/>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisInverse"
                TrueValue="Collapsed" FalseValue="Visible"/>
            <conv:InverseBoolConverter      x:Key="InverseBool"/>
            <conv:PriceFormatConverter      x:Key="PriceFormat"/>
            <conv:OrderStatusToColorConverter  x:Key="OrderStatusColor"/>
            <conv:PaymentStatusToColorConverter x:Key="PaymentStatusColor"/>
            <conv:StockStatusColorConverter  x:Key="StockColor"/>
            <conv:IntToVisibilityConverter   x:Key="IntToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
