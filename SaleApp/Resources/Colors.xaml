<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================================
         COLOR PALETTE - Modern Dark Restaurant Theme
    ====================================================== -->

    <!-- Backgrounds -->
    <Color x:Key="BackgroundColor">#0F172A</Color>
    <Color x:Key="SurfaceColor">#1E293B</Color>
    <Color x:Key="Surface2Color">#334155</Color>
    <Color x:Key="Surface3Color">#475569</Color>

    <!-- Primary Brand -->
    <Color x:Key="PrimaryColor">#FF6B35</Color>
    <Color x:Key="PrimaryDarkColor">#E85520</Color>
    <Color x:Key="PrimaryLightColor">#FF8C5A</Color>

    <!-- Secondary Accent -->
    <Color x:Key="SecondaryColor">#10B981</Color>
    <Color x:Key="SecondaryDarkColor">#059669</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>

    <!-- Status -->
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="InfoColor">#3B82F6</Color>

    <!-- Border -->
    <Color x:Key="BorderColor">#1E293B</Color>
    <Color x:Key="BorderActiveColor">#FF6B35</Color>

    <!-- ======================================================
         SOLID COLOR BRUSHES
    ====================================================== -->
    <SolidColorBrush x:Key="BackgroundBrush"     Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"        Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush"       Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="Surface3Brush"       Color="{StaticResource Surface3Color}"/>
    <SolidColorBrush x:Key="PrimaryBrush"        Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"    Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"   Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush"      Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"      Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"        Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush"        Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush"         Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InfoBrush"           Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="BorderBrush"         Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TransparentBrush"    Color="Transparent"/>

    <!-- Sidebar gradient -->
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F172A" Offset="0"/>
        <GradientStop Color="#1E1040" Offset="1"/>
    </LinearGradientBrush>

    <!-- Primary gradient button -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF6B35" Offset="0"/>
        <GradientStop Color="#F59E0B" Offset="1"/>
    </LinearGradientBrush>

    <!-- Dashboard card gradients -->
    <LinearGradientBrush x:Key="Card1Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6B35" Offset="0"/>
        <GradientStop Color="#E85520" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Card2Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0"/>
        <GradientStop Color="#059669" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Card3Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#1D4ED8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Card4Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0"/>
        <GradientStop Color="#6D28D9" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
