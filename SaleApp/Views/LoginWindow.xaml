<Window x:Class="SaleApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SaleApp.ViewModels"
        Title="SaleApp – Đăng nhập"
        Width="460" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Border CornerRadius="16" Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource Surface2Brush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Drag bar -->
            <Border Grid.Row="0" Background="Transparent" Height="36"
                    MouseLeftButtonDown="DragBar_MouseDown">
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,12,0" Width="20" Height="20"
                        Style="{StaticResource IconButton}"
                        Click="CloseButton_Click"
                        Foreground="{StaticResource TextMutedBrush}"
                        FontSize="14" Content="✕"/>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="48,8,48,40" VerticalAlignment="Center">

                <!-- Logo / Brand -->
                <Border Width="64" Height="64" CornerRadius="16" Margin="0,0,0,20"
                        HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF6B35" Offset="0"/>
                            <GradientStop Color="#F59E0B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="🍔" FontSize="30" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="SaleApp" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Hệ thống quản lý bán hàng" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,32"/>

                <!-- Username -->
                <TextBlock Text="TÊN ĐĂNG NHẬP" Style="{StaticResource InputLabel}"/>
                <TextBox x:Name="TxtUsername" Style="{StaticResource ModernTextBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16" Height="44"
                         KeyDown="Input_KeyDown"/>

                <!-- Password -->
                <TextBlock Text="MẬT KHẨU" Style="{StaticResource InputLabel}"/>
                <PasswordBox x:Name="PwdPassword" Style="{StaticResource ModernPasswordBox}"
                             Margin="0,0,0,8" Height="44"
                             KeyDown="Input_KeyDown"/>

                <!-- Error -->
                <Border Background="#20EF4444" CornerRadius="8" Padding="12,8"
                        Margin="0,8,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" FontSize="12"/>
                </Border>

                <!-- Login button -->
                <Button Content="ĐĂNG NHẬP" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}"
                        Height="44" Margin="0,20,0,0" FontSize="14"
                        Click="LoginButton_Click"/>

                <!-- Loading indicator -->
                <TextBlock Text="⏳ Đang xử lý..." FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                <!-- Register link -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock Text="Chưa có tài khoản? "
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Text="Đăng ký ngay"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontSize="12" Cursor="Hand" FontWeight="SemiBold">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding GoToRegisterCommand}"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                </StackPanel>


            </StackPanel>
        </Grid>
    </Border>
</Window>
