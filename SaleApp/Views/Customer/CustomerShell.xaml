<Window x:Class="SaleApp.Views.Customer.CustomerShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SaleApp.ViewModels.Customer"
        xmlns:views="clr-namespace:SaleApp.Views.Customer"
        Title="SaleApp – Cửa hàng"
        Width="1200" Height="780"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.DataContext>
        <vm:CustomerShellViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:StoreViewModel}">
            <views:StoreView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CartViewModel}">
            <views:CartView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrderHistoryViewModel}">
            <views:OrderHistoryView/>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="12" Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource Surface2Brush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>

        <DockPanel>
            <!-- Top navigation bar -->
            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12,12,0,0"
                    BorderBrush="{StaticResource Surface2Brush}" BorderThickness="0,0,0,1"
                    Height="60" MouseLeftButtonDown="DragBar_MouseDown">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF6B35" Offset="0"/>
                                    <GradientStop Color="#F59E0B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="🍔" FontSize="16" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="SaleApp" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Nav items -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">

                        <Button Command="{Binding ShowStoreCommand}" Padding="16,8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveMenu}" Value="Store">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏪" Margin="0,0,6,0"/>
                                <TextBlock Text="Cửa hàng"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ShowCartCommand}" Padding="16,8" Margin="4,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveMenu}" Value="Cart">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛒" Margin="0,0,6,0"/>
                                <TextBlock Text="Giỏ hàng"/>
                                <!-- Badge -->
                                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="10"
                                        Padding="5,1" Margin="4,0,0,0"
                                        Visibility="{Binding CartItemCount, Converter={StaticResource IntToVis}}">
                                    <TextBlock Text="{Binding CartBadge}" FontSize="10" FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ShowHistoryCommand}" Padding="16,8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveMenu}" Value="History">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" Margin="0,0,6,0"/>
                                <TextBlock Text="Lịch sử đơn hàng"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- User + window controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="👤 " Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                            <TextBlock Text="{Binding CustomerName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                        </StackPanel>
                        <Button Content="Đăng xuất" Style="{StaticResource SecondaryButton}"
                                Command="{Binding LogoutCommand}" Height="32" Padding="12,0"
                                Foreground="{StaticResource DangerBrush}"
                                BorderBrush="{StaticResource DangerBrush}" Margin="0,0,8,0"/>
                        <Button Content="—" Style="{StaticResource IconButton}"
                                Foreground="{StaticResource TextMutedBrush}"
                                Click="MinimizeButton_Click"/>
                        <Button Content="✕" Style="{StaticResource IconButton}"
                                Foreground="{StaticResource TextMutedBrush}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main content -->
            <ContentPresenter Content="{Binding CurrentViewModel}"/>
        </DockPanel>
    </Border>
</Window>
