<UserControl x:Class="SaleApp.Views.Customer.CartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Cart items -->
        <Border Style="{StaticResource Card}" Margin="0,0,16,0">
            <DockPanel>
                <!-- Header -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="🛒 Giỏ hàng của bạn" Style="{StaticResource PageTitle}"/>
                    <Button Content="🗑️  Xoá tất cả" HorizontalAlignment="Right"
                            Style="{StaticResource DangerButton}" Height="36"
                            Command="{Binding ClearCartCommand}"/>
                </Grid>

                <!-- Empty state -->
                <StackPanel DockPanel.Dock="Top" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="0,60"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="🛒" FontSize="56" HorizontalAlignment="Center"/>
                    <TextBlock Text="Giỏ hàng trống" FontSize="18"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="Hãy thêm sản phẩm từ cửa hàng!"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Items list -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2Brush}"
                                        CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Product info -->
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                                            <TextBlock Text="{Binding CategoryName}"
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding UnitPriceDisplay}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Qty controls -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="16,0">
                                            <Button Content="－" Style="{StaticResource SecondaryButton}"
                                                    Width="32" Height="32" Padding="0" FontSize="14"
                                                    Command="{Binding DataContext.DecreaseQtyCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding Quantity}" FontSize="15" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Width="36" TextAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Button Content="＋" Style="{StaticResource PrimaryButton}"
                                                    Width="32" Height="32" Padding="0" FontSize="14"
                                                    Command="{Binding DataContext.IncreaseQtyCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>

                                        <!-- Subtotal + remove -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SubTotalDisplay}" FontWeight="Bold"
                                                       FontSize="15" Foreground="{StaticResource PrimaryBrush}"
                                                       TextAlignment="Right"/>
                                            <Button Content="✕ Xoá" HorizontalAlignment="Right"
                                                    Style="{StaticResource IconButton}"
                                                    Foreground="{StaticResource DangerBrush}" FontSize="11"
                                                    Margin="0,4,0,0"
                                                    Command="{Binding DataContext.RemoveItemCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Order summary + checkout -->
        <StackPanel Grid.Column="1">
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Tóm tắt đơn hàng" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>

                    <Grid Margin="0,6">
                        <TextBlock Text="Tạm tính" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Cart.TotalDisplay}" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,6">
                        <TextBlock Text="Giảm giá" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="0 ₫" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>

                    <Separator Margin="0,12"/>

                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="TỔNG CỘNG" FontWeight="Bold" FontSize="15"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Cart.TotalDisplay}" HorizontalAlignment="Right"
                                   FontWeight="Bold" FontSize="18"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                    </Grid>

                    <!-- Note -->
                    <TextBlock Text="GHI CHÚ" Style="{StaticResource InputLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                             Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                             Margin="0,0,0,20"/>

                    <Button Content="✅  Thanh toán" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CheckoutCommand}"
                            Height="48" FontSize="15"
                            IsEnabled="{Binding HasItems}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
