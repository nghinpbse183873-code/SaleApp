<UserControl x:Class="SaleApp.Views.Customer.OrderHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Lịch sử đơn hàng" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Theo dõi trạng thái và lịch sử các đơn hàng của bạn"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="🔄  Làm mới" HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding RefreshCommand}" Height="36"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <DataGrid DockPanel.Dock="Top" Style="{StaticResource ModernDataGrid}"
                          ItemsSource="{Binding Orders}"
                          SelectedItem="{Binding SelectedOrder}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã đơn"     Binding="{Binding OrderCode}"   Width="130"/>
                        <DataGridTextColumn Header="Ngày đặt"   Binding="{Binding OrderedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                        <DataGridTextColumn Header="Số món"     Binding="{Binding Items.Count}" Width="60"/>
                        <DataGridTextColumn Header="Tổng tiền"  Binding="{Binding TotalDisplay}" Width="110"/>
                        <DataGridTemplateColumn Header="TT Thanh toán" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PaymentStatusText}" Margin="12,0"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding PaymentStatus, Converter={StaticResource PaymentStatusColor}}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="TT Đơn" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OrderStatusText}" Margin="12,0"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding OrderStatus, Converter={StaticResource OrderStatusColor}}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Chi tiết" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="👁  Xem" Style="{StaticResource IconButton}"
                                            Margin="8,0" Foreground="{StaticResource PrimaryBrush}"
                                            Command="{Binding DataContext.ViewDetailCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60"
                            Visibility="{Binding Orders.Count, Converter={StaticResource BoolToVisInverse}}">
                    <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Bạn chưa có đơn hàng nào" FontSize="16"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
