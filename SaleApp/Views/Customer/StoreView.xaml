<UserControl x:Class="SaleApp.Views.Customer.StoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Category sidebar -->
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource Surface2Brush}" BorderThickness="0,0,1,0"
                Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Danh mục"
                           Style="{StaticResource SectionTitle}" Margin="4,8,4,12"/>
                <ListBox ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" CornerRadius="8" Padding="10,9"
                                                Background="Transparent" Margin="0,2">
                                            <TextBlock Text="{Binding CategoryName}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="13"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1AFF6B35"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background"
                                                        Value="{StaticResource Surface2Brush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Products area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search bar with overlay watermark -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource Surface2Brush}" BorderThickness="0,0,0,1"
                    Padding="20,12">
                <Grid MaxWidth="400" HorizontalAlignment="Left">
                    <TextBox Style="{StaticResource ModernTextBox}" Height="40"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="🔍  Tìm kiếm món ăn, thức uống..." IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="14,0"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Product grid -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
                <ItemsControl ItemsSource="{Binding Products}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ProductCard}" Width="190">
                                <StackPanel>
                                    <!-- Image placeholder -->
                                    <Border Height="110" CornerRadius="10,10,0,0" ClipToBounds="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#1E293B" Offset="0"/>
                                                <GradientStop Color="#334155" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="🍽️" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Margin="12,10">
                                        <!-- Featured badge -->
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,6"
                                                Background="{StaticResource PrimaryBrush}"
                                                Visibility="{Binding Product.IsFeatured, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="⭐ NỔI BẬT" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                        </Border>

                                        <TextBlock Text="{Binding Product.ProductName}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="13" TextWrapping="Wrap" MaxHeight="38"/>
                                        <TextBlock Text="{Binding Product.CategoryName}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,2,0,6"/>

                                        <!-- Hết hàng badge -->
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                                Background="#20EF4444" Margin="0,0,0,6"
                                                Visibility="{Binding Product.IsOutOfStock, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Hết hàng" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                                        </Border>

                                        <Grid>
                                            <TextBlock Text="{Binding Product.PriceDisplay}"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       FontWeight="Bold" FontSize="14"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        
                                        <!-- Quantity and Add to Cart -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Qty controls -->
                                            <Border BorderBrush="{StaticResource Surface3Brush}" BorderThickness="1" CornerRadius="6" Height="32" Background="{StaticResource Surface2Brush}" MaxWidth="100" HorizontalAlignment="Left">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="28"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="-" Command="{Binding DecreaseCommand}" Style="{StaticResource IconButton}" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Quantity}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <Button Grid.Column="2" Content="+" Command="{Binding IncreaseCommand}" Style="{StaticResource IconButton}" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Grid>
                                            </Border>

                                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                                    Padding="12,0" Height="32" FontSize="13" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Thêm vào giỏ hàng">
                                                <Button.IsEnabled>
                                                    <Binding Path="Product.IsOutOfStock" Converter="{StaticResource InverseBool}"/>
                                                </Button.IsEnabled>
                                                <TextBlock Text="Thêm"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Products.Count}" Value="0"/>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="Không tìm thấy sản phẩm" FontSize="16"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
