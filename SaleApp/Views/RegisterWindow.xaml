<Window x:Class="SaleApp.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SaleApp.ViewModels"
        Title="SaleApp – Đăng ký tài khoản"
        Width="460" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.DataContext>
        <vm:RegisterViewModel/>
    </Window.DataContext>

    <Border CornerRadius="16" Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource Surface2Brush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" Height="36"
                    MouseLeftButtonDown="DragBar_MouseDown">
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,12,0" Width="20" Height="20"
                        Style="{StaticResource IconButton}"
                        Click="CloseButton_Click"
                        Foreground="{StaticResource TextMutedBrush}"
                        FontSize="14" Content="✕"/>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="48,4,48,36">

                    <TextBlock Text="Tạo tài khoản mới" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Chọn loại tài khoản phù hợp" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <!-- Role selection -->
                    <TextBlock Text="LOẠI TÀI KHOẢN" Style="{StaticResource InputLabel}"/>
                    <ComboBox Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding SelectedRole}"
                              DisplayMemberPath="DisplayLabel"
                              Margin="0,0,0,16" Height="44"/>


                    <!-- Full Name -->
                    <TextBlock Text="HỌ VÀ TÊN" Style="{StaticResource InputLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16" Height="44"/>

                    <!-- Username -->
                    <TextBlock Text="TÊN ĐĂNG NHẬP *" Style="{StaticResource InputLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16" Height="44"/>

                    <!-- Email -->
                    <TextBlock Text="EMAIL *" Style="{StaticResource InputLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16" Height="44"/>

                    <!-- Phone -->
                    <TextBlock Text="SỐ ĐIỆN THOẠI" Style="{StaticResource InputLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16" Height="44"/>

                    <!-- Password -->
                    <TextBlock Text="MẬT KHẨU *" Style="{StaticResource InputLabel}"/>
                    <PasswordBox x:Name="PwdPassword" Style="{StaticResource ModernPasswordBox}"
                                 Margin="0,0,0,16" Height="44"/>

                    <!-- Confirm -->
                    <TextBlock Text="XÁC NHẬN MẬT KHẨU *" Style="{StaticResource InputLabel}"/>
                    <PasswordBox x:Name="PwdConfirm" Style="{StaticResource ModernPasswordBox}"
                                 Margin="0,0,0,8" Height="44"/>

                    <!-- Error -->
                    <Border Background="#20EF4444" CornerRadius="8" Padding="12,8"
                            Margin="0,8,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" FontSize="12"/>
                    </Border>

                    <!-- Success -->
                    <Border Background="#2022C55E" CornerRadius="8" Padding="12,8"
                            Margin="0,8,0,0"
                            Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SuccessMessage}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="12"/>
                    </Border>

                    <!-- Register button -->
                    <Button Content="TẠO TÀI KHOẢN" Style="{StaticResource PrimaryButton}"
                            Height="44" Margin="0,20,0,0" FontSize="14"
                            Click="RegisterButton_Click"/>

                    <!-- Back to login -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <TextBlock Text="Đã có tài khoản? "
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="Đăng nhập"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="12" Cursor="Hand" FontWeight="SemiBold">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding GoToLoginCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
