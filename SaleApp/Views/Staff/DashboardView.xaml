<UserControl x:Class="SaleApp.Views.Staff.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SaleApp.Views.Staff"
             Background="Transparent">

    <UserControl.Resources>
        <local:RevenueToHeightConverter x:Key="RevToHeight"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel>
            <!-- Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="{Binding Greeting}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding TodayDate}"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Stat Cards Row -->
            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,24">

                <!-- Revenue -->
                <Border Margin="0,0,12,0" CornerRadius="12" Padding="20">
                    <Border.Background><StaticResource ResourceKey="Card1Gradient"/></Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#FF6B35" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="💰" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Stats.TodayRevenueDisplay}"
                                   FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Doanh thu hôm nay"
                                   FontSize="12" Foreground="#CCffffff" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Orders -->
                <Border Margin="0,0,12,0" CornerRadius="12" Padding="20">
                    <Border.Background><StaticResource ResourceKey="Card2Gradient"/></Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#10B981" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🧾" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Stats.TodayOrders}"
                                   FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Đơn hàng hôm nay"
                                   FontSize="12" Foreground="#CCffffff" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Customers -->
                <Border CornerRadius="12" Padding="20">
                    <Border.Background><StaticResource ResourceKey="Card3Gradient"/></Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#3B82F6" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="👥" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Stats.TodayCustomers}"
                                   FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Khách hàng hôm nay"
                                   FontSize="12" Foreground="#CCffffff" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Secondary row -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,12,0" CornerRadius="12" Padding="20"
                        Background="{StaticResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="📦" FontSize="20" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Stats.TotalProducts}"
                                   FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Tổng sản phẩm đang bán"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" CornerRadius="12" Padding="20"
                        Background="{StaticResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="⚠️" FontSize="20" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Stats.LowStockProducts}"
                                   FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text="Sản phẩm sắp hết hàng (≤10)"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Revenue chart + Top products -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Revenue bar chart -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Doanh thu 7 ngày qua" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,16"/>
                        <ItemsControl ItemsSource="{Binding RevenueData}" Height="160">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                Height="{Binding Revenue, Converter={StaticResource RevToHeight}}"
                                                MinHeight="4" CornerRadius="4,4,0,0"
                                                VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#FF6B35" Offset="0"/>
                                                    <GradientStop Color="#F59E0B" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Revenue, StringFormat={}{0:N0}}"
                                                       FontSize="9" Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"
                                                       Margin="0,2" TextWrapping="NoWrap"/>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding DateLabel}" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Top Products -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="🏆 Top sản phẩm" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding TopProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="14"
                                                Background="{StaticResource Surface2Brush}"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="{Binding TotalQuantitySold}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProductName}" FontSize="12"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CategoryName}" FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding RevenueDisplay}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Refresh button -->
            <Button Content="🔄  Làm mới" Style="{StaticResource SecondaryButton}"
                    Command="{Binding RefreshCommand}"
                    HorizontalAlignment="Right" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
