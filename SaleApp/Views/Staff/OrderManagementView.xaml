<UserControl x:Class="SaleApp.Views.Staff.OrderManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Quản lý Đơn hàng" Style="{StaticResource PageTitle}"/>
            <Button Content="🔄  Làm mới" HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding RefreshCommand}" Height="36"/>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <!-- Search with overlay watermark -->
                <Grid>
                    <TextBox Style="{StaticResource ModernTextBox}" Height="40"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="🔍  Mã đơn, tên khách hàng..." IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="14,0"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- Orders Grid -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DataGrid Style="{StaticResource ModernDataGrid}"
                      ItemsSource="{Binding Orders}"
                      SelectedItem="{Binding SelectedOrder}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã đơn"     Binding="{Binding OrderCode}"   Width="130"/>
                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="SĐT"        Binding="{Binding CustomerPhone}" Width="110"/>
                    <DataGridTextColumn Header="Tổng tiền"  Binding="{Binding TotalDisplay}" Width="110"/>
                    <DataGridTemplateColumn Header="TT Đơn" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OrderStatusText}" Margin="12,0" FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding OrderStatus, Converter={StaticResource OrderStatusColor}}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="TT Thanh toán" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PaymentStatusText}" Margin="12,0" FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding PaymentStatus, Converter={StaticResource PaymentStatusColor}}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Thời gian"  Binding="{Binding OrderedAt, StringFormat=dd/MM HH:mm}" Width="100"/>
                    <DataGridTemplateColumn Header="Thao tác" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                    <Button Content="👁" Style="{StaticResource IconButton}" ToolTip="Xem chi tiết"
                                            Command="{Binding DataContext.ViewDetailCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            Margin="0,0,2,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Summary bar -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center">
                <Run Text="Tổng:"/>
                <Run Text="{Binding Orders.Count, Mode=OneWay}" FontWeight="Bold"
                     Foreground="{StaticResource TextPrimaryBrush}"/>
                <Run Text=" đơn hàng"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
