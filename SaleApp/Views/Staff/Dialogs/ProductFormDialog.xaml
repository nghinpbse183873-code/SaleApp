<Window x:Class="SaleApp.Views.Staff.Dialogs.ProductFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sản phẩm" Width="520" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border CornerRadius="12" Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource Surface2Brush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12,12,0,0" Padding="20,0"
                    MouseLeftButtonDown="DragBar_MouseDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}"
                            Foreground="{StaticResource TextMutedBrush}" Click="CancelButton_Click"/>
                    <TextBlock x:Name="TxtTitle" Text="Thêm sản phẩm" Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
                <StackPanel>
                    <!-- Product name -->
                    <TextBlock Text="TÊN SẢN PHẨM *" Style="{StaticResource InputLabel}"/>
                    <TextBox x:Name="TxtName" Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,16" Height="44"/>

                    <!-- Category -->
                    <TextBlock Text="DANH MỤC *" Style="{StaticResource InputLabel}"/>
                    <ComboBox x:Name="CmbCategory" Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId"
                              Margin="0,0,0,16" Height="44"/>

                    <!-- Price row -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="GIÁ BÁN (₫) *" Style="{StaticResource InputLabel}"/>
                            <TextBox x:Name="TxtPrice" Style="{StaticResource ModernTextBox}" Height="44"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="GIÁ VỐN (₫)" Style="{StaticResource InputLabel}"/>
                            <TextBox x:Name="TxtCostPrice" Style="{StaticResource ModernTextBox}" Height="44"/>
                        </StackPanel>
                    </Grid>

                    <!-- Stock + Unit -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="TỒN KHO *" Style="{StaticResource InputLabel}"/>
                            <TextBox x:Name="TxtStock" Style="{StaticResource ModernTextBox}" Height="44" Text="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ĐƠN VỊ" Style="{StaticResource InputLabel}"/>
                            <TextBox x:Name="TxtUnit" Style="{StaticResource ModernTextBox}" Height="44"
                                     Text="phần"/>
                        </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <TextBlock Text="MÔ TẢ" Style="{StaticResource InputLabel}"/>
                    <TextBox x:Name="TxtDesc" Style="{StaticResource ModernTextBox}"
                             Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

                    <!-- Checkboxes -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox x:Name="ChkActive" Content="Đang bán" IsChecked="True"
                                  Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,20,0"/>
                        <CheckBox x:Name="ChkFeatured" Content="Nổi bật"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Error -->
                    <Border x:Name="ErrorBorder" Background="#20EF4444" CornerRadius="8"
                            Padding="12,8" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock x:Name="TxtError" Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" FontSize="12"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer buttons -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="0,0,12,12" Padding="24,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Huỷ" Style="{StaticResource SecondaryButton}"
                            Click="CancelButton_Click" Height="40" Margin="0,0,12,0" Padding="20,0"/>
                    <Button Content="💾  Lưu sản phẩm" Style="{StaticResource PrimaryButton}"
                            Click="SaveButton_Click" Height="40" Padding="20,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
