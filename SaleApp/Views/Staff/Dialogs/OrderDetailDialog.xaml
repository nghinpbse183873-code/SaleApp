<Window x:Class="SaleApp.Views.Staff.Dialogs.OrderDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết đơn hàng" Width="600" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border CornerRadius="12" Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource Surface2Brush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12,12,0,0" Padding="20,0"
                    MouseLeftButtonDown="DragBar_MouseDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}"
                            Foreground="{StaticResource TextMutedBrush}" Click="CloseButton_Click"/>
                    <TextBlock Text="{Binding OrderCode, StringFormat='Đơn hàng: {0}'}"
                               Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
                <StackPanel>
                    <!-- Customer info -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="KHÁCH HÀNG" Style="{StaticResource InputLabel}"/>
                                <TextBlock Text="{Binding CustomerName}"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CustomerUsername}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding CustomerPhone}"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="THÔNG TIN ĐƠN" Style="{StaticResource InputLabel}"/>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                    <Run Text="Ngày đặt:"/>
                                    <Run Text="{Binding OrderedAt, StringFormat=dd/MM/yyyy HH:mm}"
                                         Foreground="{StaticResource TextPrimaryBrush}"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                    <Run Text="Thanh toán:"/>
                                    <Run Text="{Binding PaymentMethod}"
                                         Foreground="{StaticResource TextPrimaryBrush}"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                    <Run Text="Nhân viên:"/>
                                    <Run Text="{Binding StaffUsername}"
                                         Foreground="{StaticResource TextPrimaryBrush}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Status badges -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border CornerRadius="6" Padding="12,5" Margin="0,0,8,0"
                                Background="{Binding PaymentStatus, Converter={StaticResource PaymentStatusColor}}">
                            <Border.Opacity>0.2</Border.Opacity>
                        </Border>
                        <TextBlock Text="{Binding PaymentStatusText}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{Binding PaymentStatus, Converter={StaticResource PaymentStatusColor}}"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding OrderStatusText}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{Binding OrderStatus, Converter={StaticResource OrderStatusColor}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Items -->
                    <TextBlock Text="CHI TIẾT SẢN PHẨM" Style="{StaticResource InputLabel}" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding Items}"
                              Style="{StaticResource ModernDataGrid}"
                              MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sản phẩm"  Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Danh mục"  Binding="{Binding CategoryName}" Width="100"/>
                            <DataGridTextColumn Header="SL"        Binding="{Binding Quantity}"     Width="40"/>
                            <DataGridTextColumn Header="Đơn giá"   Binding="{Binding UnitPriceDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Thành tiền" Binding="{Binding TotalPriceDisplay}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Summary -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                            Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,4">
                                <TextBlock Text="Tạm tính:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding SubTotalDisplay}" HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <TextBlock Text="Giảm giá:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding DiscountDisplay}" HorizontalAlignment="Right"
                                           Foreground="{StaticResource DangerBrush}"/>
                            </Grid>
                            <Separator Margin="0,8"/>
                            <Grid>
                                <TextBlock Text="TỔNG CỘNG:" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="15"/>
                                <TextBlock Text="{Binding TotalDisplay}" HorizontalAlignment="Right"
                                           FontWeight="Bold" FontSize="16"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Note -->
                    <Border Visibility="{Binding Note, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource Surface2Brush}" CornerRadius="8"
                            Padding="12,8" Margin="0,12,0,0">
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                            <Run Text="📝 Ghi chú: "/>
                            <Run Text="{Binding Note}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="0,0,12,12" Padding="24,12">
                <Button Content="Đóng" Style="{StaticResource SecondaryButton}"
                        Click="CloseButton_Click" HorizontalAlignment="Right"
                        Height="40" Padding="24,0"/>
            </Border>
        </Grid>
    </Border>
</Window>
