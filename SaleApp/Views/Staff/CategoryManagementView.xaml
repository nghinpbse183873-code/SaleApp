<UserControl x:Class="SaleApp.Views.Staff.CategoryManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Category list -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Danh mục" Style="{StaticResource PageTitle}"/>
                    <Button Content="＋ Thêm" HorizontalAlignment="Right"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NewCommand}" Height="36" Padding="12,0"/>
                </Grid>

                <ListBox ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                                        <Run Text="{Binding ProductCount, Mode=OneWay}"/>
                                                        <Run Text=" sản phẩm"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="● Hoạt động"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Text" Value="○ Ẩn"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1AFF6B35"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right: Edit form -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Margin="0,0,0,20">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                            <Setter Property="Text" Value="Chỉnh sửa danh mục"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Null}">
                                    <Setter Property="Text" Value="Thêm danh mục mới"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="TÊN DANH MỤC *" Style="{StaticResource InputLabel}"/>
                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsEditing}"
                         Margin="0,0,0,16" Height="44"/>

                <TextBlock Text="MÔ TẢ" Style="{StaticResource InputLabel}"/>
                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding EditDesc, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsEditing}"
                         Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                         Margin="0,0,0,24" VerticalScrollBarVisibility="Auto"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="💾  Lưu" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" Height="40" Margin="0,0,12,0"/>
                    <Button Content="Huỷ" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}" Height="40" Margin="0,0,12,0"/>
                    <Button Content="🗑️  Ẩn" Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteCommand}" Height="40"/>
                </StackPanel>

                <Border Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="16"
                        Margin="0,24,0,0"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInverse}}">
                    <TextBlock Text="👈 Chọn danh mục bên trái để sửa, hoặc bấm Thêm để tạo mới."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
